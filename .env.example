# Google Generative AI / Gemini API
VITE_GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# LocationIQ Geocoding API
VITE_LOCATION_IQ_TOKENS=your_locationiq_api_key_here

# Pexels Image API
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Firebase configuration is set in src/service/firebaseConfig.jsx

# Get your API keys from:
# - Google AI Studio: https://aistudio.google.com/app/apikey
# - LocationIQ: https://locationiq.com/
# - Pexels: https://www.pexels.com/api/
# - Clerk: https://dashboard.clerk.com

